# --- Application (copier en .env.local) ---
# Sans ces variables, l'application tourne en mode démonstration (données sur l'appareil).
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Assistant : URL de la fonction "assistant" (sinon, réponses locales de base)
NEXT_PUBLIC_ASSISTANT_URL=https://<PROJECT_REF>.supabase.co/functions/v1/assistant

# --- Fonctions Supabase (à définir avec `supabase secrets set NOM=valeur`, jamais dans l'app) ---
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.
BREVO_API_KEY=
MAIL_FROM=bonjour@votre-domaine.fr
MAIL_FROM_NAME=Sillage
APP_URL=https://app.votre-domaine.fr
# Assistant et avis sur les correspondances INSEE douteuses
ANTHROPIC_API_KEY=
