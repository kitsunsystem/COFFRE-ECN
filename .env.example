# --- Application (copier en .env.local pour lancer la version de production en local) ---
# Sans ces deux variables, l'application est la démonstration (données sur l'appareil).
NEXT_PUBLIC_SUPABASE_URL=https://api.votre-domaine.fr
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Domaine des cartes FIDO2 (WebAuthn). Vide = le domaine courant. Ne plus le changer une fois des cartes activées.
NEXT_PUBLIC_FIDO_RP_ID=app.votre-domaine.fr
NEXT_PUBLIC_APP_URL=https://app.votre-domaine.fr
# Tests de bout en bout uniquement : "demo" simule les cartes sur un vrai Supabase. Jamais en production.
NEXT_PUBLIC_CARD_DRIVER=

# --- Fonctions serveur (supabase secrets set NOM=valeur ; jamais dans l'application) ---
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement aux fonctions.
APP_URL=https://app.votre-domaine.fr
# Origines autorisées à appeler les fonctions depuis un navigateur (séparées par des virgules).
APP_ORIGINS=https://app.votre-domaine.fr
# E-mails (Brevo)
BREVO_API_KEY=
MAIL_FROM=bonjour@votre-domaine.fr
MAIL_FROM_NAME=Sillage
# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Vérification d'identité (système KYC du groupe, quand il sera branché)
KYC_WEBHOOK_SECRET=
# Assistante et avis sur les correspondances INSEE douteuses (prestataire IA à décider)
ANTHROPIC_API_KEY=
